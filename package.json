{
  "name": "usefuldesk",
  "version": "0.7.0",
  "private": true,
  "description": "India-first gym CRM for renewals, payments, attendance, leads, and WhatsApp conversations.",
  "license": "MIT",
  "author": "Rajat Kashyap",
  "homepage": "https://desk.usefulmade.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarkay1805/UsefulDesk.git"
  },
  "bugs": {
    "url": "https://github.com/aarkay1805/UsefulDesk/issues"
  },
  "keywords": [
    "gym-crm",
    "india",
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "renewals",
    "attendance"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "accept:razorpay": "node scripts/razorpay-provider-acceptance.mjs",
    "accept:razorpay-refunds": "node scripts/razorpay-refund-provider-preflight.mjs",
    "migrate:payment-receipts": "node --env-file=.env.local scripts/migrate-payment-receipts.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-oriya": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@react-pdf/renderer": "^4.8.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "next": "16.3.0",
    "opus-recorder": "^8.0.5",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.2",
    "read-excel-file": "^9.3.4",
    "recharts": "^3.8.1",
    "server-only": "0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "ip-address": "^10.5.0",
    "fast-uri": "^3.1.5",
    "hono": "^4.13.1",
    "js-yaml": "^4.3.1",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.3",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9",
    "@hono/node-server": "^2.0.5",
    "body-parser": "^2.3.0",
    "undici": "^7.29.0",
    "nanoid": "^3.3.17"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
